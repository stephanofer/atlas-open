# Supabase Configuration
# Get these values from: https://supabase.com/dashboard/project/_/settings/api

# Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/Public Key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# Server-side only (Cloudflare Workers secrets)
# These should be set via `wrangler secret put` or in .dev.vars
# ============================================

# Supabase URL (same as VITE_SUPABASE_URL, but for the worker)
SUPABASE_URL=https://edutskmrcxzmwdkcqcdf.supabase.co

